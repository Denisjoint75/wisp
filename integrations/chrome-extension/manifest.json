{
  "manifest_version": 3,
  "name": "Wisp",
  "version": "0.1.3",
  "description": "Lets Wisp, the macOS computer-use daemon, read and operate the tabs of this browser.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Wisp",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
